# Supabase Postgres. Use the "Session pooler" connection string from
# Supabase -> Connect (works on IPv4 networks). postgresql:// URLs are fine;
# the app switches them to the psycopg 3 driver automatically.
DATABASE_URL=postgresql://postgres.your-project-ref:password@aws-0-your-region.pooler.supabase.com:5432/postgres

# Supabase Auth
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated
# Only for projects that still sign tokens with the legacy shared secret
# (Project Settings -> API -> JWT Settings). Projects using JWT signing keys
# are verified through the public JWKS endpoint and don't need this.
# SUPABASE_JWT_SECRET=
# Optional when using a custom Supabase issuer.
# SUPABASE_JWT_ISSUER=https://your-project-ref.supabase.co/auth/v1

# Deployed dashboard origin(s) allowed by CORS, comma-separated.
# http://localhost:<any port> and http://127.0.0.1:<any port> are always allowed.
FRONTEND_URL=http://localhost:3000

# Gemini (AI Copilot + WhatsApp order parsing). Key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite

# Reporting
BUSINESS_TIMEZONE=Asia/Kolkata
AGGREGATOR_COMMISSION_PERCENT=20

# Twilio WhatsApp
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
# Set to the exact webhook URL entered in the Twilio console if a tunnel/proxy
# changes the host or scheme and signature checks fail.
# TWILIO_WEBHOOK_URL=https://your-tunnel.example/api/whatsapp/webhook
# Signature checks reject forged webhook calls. Only disable for local experiments.
TWILIO_VALIDATE_SIGNATURE=true
